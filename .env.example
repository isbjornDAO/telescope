# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/telescope?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Auth (NextAuth)
# ---------------------------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Telescope mirrors the providers build.avax.network offers, so a builder signs
# in with the same credentials and lands on the same identity. Configure at
# least one — each is optional, and only the ones you set are shown.

# https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in links. Any SMTP server works.
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Telescope <hello@example.com>"

# Optional: the existing community can keep signing in with Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated emails granted the admin role on first sign-in.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Discord bot, used by the events calendar.
DISCORD_BOT_TOKEN=

# Wallet linking (rewards and bounty payouts). Not needed to sign in.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
