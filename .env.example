# Required for MongoDB connection
DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.h4wdu.mongodb.net/vote?retryWrites=true&w=majority"

# Discord OAuth2 credentials (from Discord Developer Portal)
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# NextAuth configuration
NEXTAUTH_SECRET=your_random_32_char_secret_here
NEXTAUTH_URL=http://localhost:3000

# WalletConnect project ID (from walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wc_project_id_here

# Optional: Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Optional: Vercel deployment URL
NEXT_PUBLIC_VERCEL_URL=https://your-vercel-app.vercel.app
# Discord Bot Configuration (for forum notifications)
DISCORD_GENERAL_CHANNEL_ID=your_general_channel_id_here
BOT_PORT=3001

# Webhook security
WEBHOOK_SECRET=your_random_webhook_secret_here
BOT_WEBHOOK_URL=http://localhost:3001

# ── Telescope world (World Rules v0.1) ───────────────────────────────
# Key for AES-GCM at rest (ballots, scout disclosures). Falls back to NEXTAUTH_SECRET.
WORLD_ENCRYPTION_KEY=another_random_32_char_secret
# Protects /api/world/jobs/tick (nightly cron: seasons, trust recompute, retention, scout cleanup)
CRON_SECRET=your_cron_secret
# Wallets allowed into /world-admin (comma separated). Discord admins also qualify.
WORLD_ADMIN_ADDRESSES=0x...
# Scout capacity above the free budget, priced in USDC on the C-Chain (MVP). Leave empty to keep top-ups closed.
SCOUT_TREASURY_ADDRESS=
USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
# Builder's Hub proof import. Leave empty until the integration is live; manual proofs work meanwhile.
BUILDERS_HUB_API_URL=
BUILDERS_HUB_API_KEY=
