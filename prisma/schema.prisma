// Telescope — community platform for build.avax.network
//
// Identity is email-first so a builder arriving from build.avax.network signs in
// with the same credentials they already use there (GitHub / Google / email code).
// A wallet is an optional linked credential, not a login.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  handle        String?   @unique // @mention name, generated on first sign-in
  image         String?
  bio           String?
  role          String    @default("member") // member | moderator | admin

  // A wallet is an optional linked credential, held in its own model. It used
  // to be a `String? @unique` here, which is unworkable on MongoDB: Prisma
  // writes an explicit null for an absent optional scalar, and a unique index
  // rejects the second document holding that null — so the second wallet-less
  // signup failed outright. Rows in Wallet exist only for users who linked one,
  // so the unique index applies to real addresses and nothing collides.
  wallets Wallet[]

  discordId String?

  // Reputation is earned in the forum: upvotes and accepted answers.
  reputation Int @default(0)

  // Legacy loyalty economy, retained: xp levels the profile, coins are spent.
  xp            Int @default(0)
  coins         Int @default(0)
  level         Int @default(1)
  streak        Int @default(0)
  longestStreak Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastActive DateTime?

  accounts Account[]
  sessions Session[]

  topics    Topic[]
  replies   Reply[]
  postVotes PostVote[]

  claims       Claim[]
  collectables UserCollectable[]

  // Legacy relations kept so historical records stay readable.
  votes    Vote[]
  votesS1  VoteS1[]
  artVotes ArtVote[]

  @@index([reputation])
}

model Wallet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  address   String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The primary wallet receives bounty payouts when a user links more than one.
  primary   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

// NextAuth adapter models.

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String // github | google | email | builders-hub
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Forum — questions with accepted answers, plus open discussion
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique // e.g. "subnets", "tooling", "help"
  title       String
  description String
  icon        String? // lucide icon name
  position    Int     @default(0)
  archived    Boolean @default(false)

  createdAt DateTime @default(now())
  topics    Topic[]

  @@index([position])
}

model Topic {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  slug       String @unique
  title      String
  body       String
  // "question" topics can be solved and show an accepted answer.
  // "discussion" topics are plain threads.
  kind       String @default("question")
  tags       String[] @default([])

  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  authorId String @db.ObjectId
  author   User   @relation(fields: [authorId], references: [id])

  // Denormalised counters — the topic list reads these instead of aggregating.
  score      Int @default(0)
  replyCount Int @default(0)
  viewCount  Int @default(0)

  acceptedReplyId String? @db.ObjectId
  solved          Boolean @default(false)

  pinned Boolean @default(false)
  locked Boolean @default(false)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActivity DateTime  @default(now())
  deleted      Boolean   @default(false)
  deletedAt    DateTime?

  replies Reply[]

  @@index([categoryId, lastActivity])
  @@index([lastActivity])
  @@index([solved])
  @@index([authorId])
  @@index([tags])
}

model Reply {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  body    String
  topicId String @db.ObjectId
  topic   Topic  @relation(fields: [topicId], references: [id])

  authorId String @db.ObjectId
  author   User   @relation(fields: [authorId], references: [id])

  // Set when this reply answers the question; mirrored by Topic.acceptedReplyId.
  accepted Boolean @default(false)

  // Threaded replies: null for a top-level answer.
  parentId String? @db.ObjectId

  score Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deleted   Boolean   @default(false)
  deletedAt DateTime?

  @@index([topicId, createdAt])
  @@index([authorId])
}

model PostVote {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Exactly one of these is set; targetType says which.
  targetId   String @db.ObjectId
  targetType String // "topic" | "reply"

  value Int // 1 or -1

  createdAt DateTime @default(now())

  @@unique([userId, targetId])
  @@index([targetId])
}

model Tag {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique
  description String?
  topicCount  Int     @default(0)

  @@index([topicCount])
}

// ---------------------------------------------------------------------------
// Rewards
// ---------------------------------------------------------------------------

model Reward {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  description      String
  imageUrl         String
  nftCollectionUrl String
  tokenId          String?
  xpRequired       Int
  totalAvailable   Int
  claimed          Int       @default(0)
  active           Boolean   @default(true)
  limitedTime      Boolean   @default(false)
  availableUntil   DateTime?
  contractAddress  String?
  requiredYear     Int?
  createdAt        DateTime  @default(now())
  claims           Claim[]
}

model Claim {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  rewardId   String   @db.ObjectId
  reward     Reward   @relation(fields: [rewardId], references: [id])
  claimedAt  DateTime @default(now())
  coinsSpent Int
}

model Collectable {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  collectableId    String            @unique
  name             String
  description      String
  imageUrl         String
  rarity           String            @default("common")
  category         String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  userCollectables UserCollectable[]
}

model UserCollectable {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id])
  collectableId String      @db.ObjectId
  collectable   Collectable @relation(fields: [collectableId], references: [id])
  acquiredAt    DateTime    @default(now())
  nftMinted     Boolean     @default(false)
  nftTokenId    String?

  @@unique([userId, collectableId])
}

model AdminSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  voteLock  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Archived — project voting and the art programme. Read-only history; no UI
// points at these any more. Kept so nothing in the live database is orphaned.
// ---------------------------------------------------------------------------

model Project {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String?
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  social      Social?
  metadata    Json?
  votes       Vote[]
  tags        String[]  @default([])
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
}

model Vote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String   @db.ObjectId
  votedDate DateTime @default(now())
  type      String   @default("like")
}

model ProjectS1 {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String?
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  social      Social?
  metadata    Json?
  votes       VoteS1[]
  tags        String[]  @default([])
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
}

model VoteS1 {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  userId    String     @db.ObjectId
  project   ProjectS1? @relation(fields: [projectId], references: [id])
  projectId String     @db.ObjectId
  votedDate DateTime   @default(now())
  type      String     @default("like")
}

type Social {
  twitter         String?
  discord         String?
  telegram        String?
  website         String?
  dexscreener     String?
  contractAddress String?
}

model ArtSubmission {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  artistAddress String
  artistName    String?
  discordId     String?
  title         String
  description   String?
  artworkUrl    String
  cohort        Int       @default(1)
  prompt        String
  status        String    @default("pending")
  votesReceived Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  votes         ArtVote[]
}

model ArtVote {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String        @db.ObjectId
  user         User          @relation(fields: [userId], references: [id])
  submissionId String        @db.ObjectId
  submission   ArtSubmission @relation(fields: [submissionId], references: [id])
  cohort       Int
  createdAt    DateTime      @default(now())
}

// Legacy anonymous imageboard. Superseded by Category/Topic/Reply.
model Board {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String   @unique
  title               String
  description         String
  createdAt           DateTime @default(now())
  totalThreadsCreated Int      @default(0)
  threads             Thread[]
}

model Thread {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  boardId    String    @db.ObjectId
  board      Board     @relation(fields: [boardId], references: [id])
  subject    String?
  bumpedAt   DateTime  @default(now())
  createdAt  DateTime  @default(now())
  replyCount Int       @default(0)
  posts      Post[]
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
}

model Post {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  threadId      String   @db.ObjectId
  thread        Thread   @relation(fields: [threadId], references: [id])
  comment       String
  imageHash     String?
  walletAddress String
  posterId      String
  isOp          Boolean  @default(false)
  anonymous     Boolean  @default(true)
  createdAt     DateTime @default(now())
}
